function cm2(){document.getElementById('nav').classList.remove('open');}
const obs=new IntersectionObserver(e=>{e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('on');obs.unobserve(x.target);}})},{threshold:.1});
document.querySelectorAll('.reveal').forEach(e=>obs.observe(e));

let dados={tipo:'',local:'',urgencia:''};
const NOMES={1:'Tipo de Barreira',2:'Local da Ocorrência',3:'Nível de Urgência',4:'Detalhes da Demanda'};

function mostrarEtapa(n){
  ['s1','s2','s3','s4','s5'].forEach(id=>{const el=document.getElementById(id);if(el)el.style.display='none';});
  const alvo=document.getElementById('s'+n);
  if(alvo){alvo.style.display='block';alvo.classList.remove('step-hide');}
  for(let i=1;i<=4;i++){const p=document.getElementById('p'+i);if(p){if(i<=Math.min(n,4))p.classList.add('on');else p.classList.remove('on');}}
  if(document.getElementById('stepNum'))document.getElementById('stepNum').textContent=Math.min(n,4);
  if(document.getElementById('stepName')&&NOMES[n])document.getElementById('stepName').textContent=NOMES[n];
  document.getElementById('sistema').scrollIntoView({behavior:'smooth',block:'start'});
}
function avancar(n){mostrarEtapa(n);}
function voltar(n){mostrarEtapa(n);}

document.querySelectorAll('#s1 .opt').forEach(btn=>{
  btn.addEventListener('click',()=>{
    document.querySelectorAll('#s1 .opt').forEach(b=>b.classList.remove('selected'));
    btn.classList.add('selected');
    dados.tipo=btn.dataset.tipo;
    const b=document.getElementById('btn1');
    b.disabled=false;
    b.classList.add('ready');
  });
});
document.querySelectorAll('#s2 .opt').forEach(btn=>{
  btn.addEventListener('click',()=>{
    document.querySelectorAll('#s2 .opt').forEach(b=>b.classList.remove('selected'));
    btn.classList.add('selected');
    dados.local=btn.dataset.local;
    const b=document.getElementById('btn2');
    b.disabled=false;
    b.classList.add('ready');
  });
});
document.querySelectorAll('#s3 .opt').forEach(btn=>{
  btn.addEventListener('click',()=>{
    document.querySelectorAll('#s3 .opt').forEach(b=>b.classList.remove('selected'));
