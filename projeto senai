}
function addMsg(t,s){const d=document.createElement('div');d.className='msg '+s;d.innerHTML=t;cbd.appendChild(d);cbd.scrollTop=cbd.scrollHeight;}
function botReply(t){
  const d=document.createElement('div');d.className='msg typing';d.innerHTML='<span></span><span></span><span></span>';
  cbd.appendChild(d);cbd.scrollTop=cbd.scrollHeight;
  setTimeout(()=>{d.remove();addMsg(t,'bot');},700);
}
function send(){const v=ci.value.trim();if(!v)return;addMsg(v,'user');ci.value='';botReply(resposta(v));}
function qa(t){addMsg(t,'user');botReply(resposta(t));}
function resposta(m){
  const x=m.toLowerCase();
  if(x.includes('acessibilidade')&&(x.includes('o que')||x.includes('que é')))return '📖 <b>Acessibilidade</b> é garantir que todas as pessoas, com ou sem deficiência, usem espaços, serviços e informações com autonomia. Nosso projeto combate barreiras arquitetônicas, comunicacionais, tecnológicas, institucionais e atitudinais.';
  if(x.includes('lei')||x.includes('lbi')||x.includes('legisla')||x.includes('direito'))return '⚖️ Principais leis:<br>• <b>Lei 13.146/2015</b> — LBI (Estatuto da Pessoa com Deficiência)<br>• <b>Lei 8.213/91</b> — Lei de Cotas<br>• <b>Decreto 5.296/2004</b> — Acessibilidade<br>• <b>NBR 9050</b> — Norma técnica de acessibilidade';
  if(x.includes('ia')||x.includes('inteligência')||x.includes('como ajuda'))return '🤖 A IA do nosso sistema:<br>• Classifica automaticamente as barreiras<br>• Prioriza por gravidade<br>• Gera planos de ação personalizados<br>• Elimina processos manuais e reativos<br>• Centraliza dados para gestão integrada';
  if(x.includes('capacitismo'))return '🧠 <b>Capacitismo</b> é o preconceito e discriminação contra pessoas com deficiência. Se manifesta em atitudes, palavras, políticas e estruturas que tratam PCD como inferiores. Combatemos com conscientização e treinamento.';
  if(x.includes('pcd')||x.includes('deficiên'))return '♿ Pessoas com Deficiência têm direito a adaptações, tecnologias assistivas, comunicação acessível e atendimento prioritário. Nosso sistema garante agilidade nessas demandas.';
  if(x.includes('petrobras'))return '🏢 A Petrobras é parceira deste projeto. O sistema otimiza a gestão de acessibilidade em todas as unidades — refinarias, plataformas, escritórios e sistemas digitais.';
  if(x.includes('solicit')||x.includes('recurso')||x.includes('pedir')||x.includes('registrar'))return '📝 Para registrar uma demanda: use o <b>formulário acima</b> 👆 Escolha o tipo de barreira, o local e a urgência. A IA gera o plano de ação e envia automaticamente!';
  if(x.includes('contato')||x.includes('email')||x.includes('falar'))return '📧 Contato: <b>felipecosta02838@gmail.com</b><br>Ou registre sua demanda no formulário acima!';
  if(x.includes('obrigad')||x.includes('valeu')||x.includes('tchau'))return 'Por nada! 💚 Estou aqui sempre que precisar. Juntos por uma acessibilidade digital cada vez melhor! 🌟';
  if(x.includes('oi')||x.includes('olá')||x.includes('ola')||x.includes('bom dia')||x.includes('boa tarde'))return 'Olá! 👋 Bem-vindo ao <b>Acessibilidade Digital</b>. Como posso ajudar? Posso falar sobre acessibilidade, leis, capacitismo ou como usar o sistema.';
  if(x.includes('senai')||x.includes('feira')||x.includes('projeto'))return '🎓 Este é o projeto <b>Acessibilidade Digital</b> da Feira SENAI — "Otimização da Gestão de Acessibilidade e Inclusão Organizacional via IA", parceria Petrobras + Instituto SENAI de Tecnologia de Mato Grosso.';
  if(x.includes('como usar')||x.includes('como funciona')||x.includes('etapa'))return '📋 Como usar:<br>1️⃣ Escolha o <b>tipo de barreira</b><br>2️⃣ Informe o <b>local</b><br>3️⃣ Selecione a <b>urgência</b><br>4️⃣ Preencha seus dados<br>5️⃣ Clique em <b>"Processar com IA"</b><br>A IA gera um plano de ação personalizado!';
  return '🤔 Boa pergunta! Posso te ajudar com: <b>acessibilidade, leis (LBI), capacitismo, como a IA funciona, ou como registrar uma demanda</b>. O que prefere?';
}

